  "notes": [
    {
      "title": "Requisito de escritura (REQE)",
      "text": "Lo cumple el curso Pensar, comunicar y colaborar (CCOM 1100), de 3 créditos."
    },
    {
      "title": "Requisito de idioma extranjero (REQIE)",
      "text": "Incluye el requisito de lectura en inglés, necesario para inscribir FISI 2605 Mecánica, y el de dominio de una segunda lengua, necesario para el grado."
    },
    {
      "title": "Opciones de grado",
      "text": "FISI 3989 Investigación o monografía, FISI 3988 Pasantía de investigación y FISI 3987 Pasantía laboral. Cualquiera requiere la aprobación previa del Comité de Pregrado."
    },
    {
      "title": "Correquisitos y bolsas",
      "text": "Los códigos con * son correquisitos: se debe estar cursando o haber aprobado el curso. Los cursos con ** son bolsas de créditos."
    },
    {
      "title": "Ciclo Básico Uniandino",
      "text": "5 cursos CBU de 3 créditos. El curso común de Colombia es obligatorio."
    }
  ],
